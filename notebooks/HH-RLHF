        "import re, gzip, json\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# ── IDENTIFY FILES BY ROW COUNT ───────────────────────────────────────────────\n",
        "# Filenames from Google Drive downloads are not predictable\n",
        "# We identify each subset by counting rows — counts are unique per subset\n",
        "# harmless-base (42,537) is excluded: wrong preference direction for our purpose\n",
        "# See Bai et al. (2022) Section 2.2 — harmless crowdworkers selected MORE harmful\n",
        "# response, making it structurally incompatible with naturalistic norm extraction\n",
        "\n",
        "ROW_COUNT_TO_SUBSET = {\n",
        "    43835: \"helpful_base\",   # Subset A\n",
        "    22007: \"helpful_online\", # Subset B (merged with helpful_rej)\n",
        "    52421: \"helpful_rej\",    # Subset B (merged with helpful_online)\n",
        "    42537: None,             # harmless-base — excluded\n",
        "}\n",
        "\n",
        "# Three subsets mirroring CMV structure\n",
        "# helpful-online and helpful-rejection-sampled merge into Subset B\n",
        "# because both are extensions of the helpful annotation process\n",
        "SUBSET_REMAP = {\n",
        "    \"helpful_base\"  : \"subset_A\",\n",
        "    \"helpful_online\": \"subset_B\",\n",
        "    \"helpful_rej\"   : \"subset_B\",\n",
        "}\n",
        "\n",
        "def count_rows(fname):\n",
        "    with gzip.open(fname, \"rt\", encoding=\"utf-8\") as f:\n",
        "        return sum(1 for line in f if line.strip())\n",
        "\n",
        "def parse_hh_row(chosen, rejected, source):\n",
        "    chosen_parts   = chosen.split(\"\\n\\nAssistant: \")\n",
        "    rejected_parts = rejected.split(\"\\n\\nAssistant: \")\n",
        "    chosen_final   = chosen_parts[-1].strip()\n",
        "    rejected_final = rejected_parts[-1].strip()\n",
        "    context        = \"\\n\\nAssistant: \".join(chosen_parts[:-1]).strip()\n",
        "    human_turns    = re.findall(r\"Human: (.+?)(?=\\n\\n|$)\", chosen, re.DOTALL)\n",
        "    first_human    = human_turns[0].strip() if human_turns else \"\"\n",
        "    n_human_turns  = len(re.findall(r\"\\n\\nHuman: \", chosen)) + 1\n",
        "    return {\n",
        "        \"source_subset\"    : source,\n",
        "        \"human_context\"    : context,\n",
        "        \"first_human_turn\" : first_human,\n",
        "        \"chosen_response\"  : chosen_final,\n",
        "        \"rejected_response\": rejected_final,\n",
        "        \"n_human_turns\"    : n_human_turns,\n",
        "        \"is_single_turn\"   : n_human_turns == 1,\n",
        "        \"earned_delta\"     : 1,\n",
        "    }\n",
        "\n",
        "# ── IDENTIFY AND PARSE ────────────────────────────────────────────────────────\n",
        "all_rows = []\n",
        "skipped  = []\n",
        "\n",
        "for fname in uploaded.keys():\n",
        "    print(f\"Counting rows in {fname}...\")\n",
        "    n = count_rows(fname)\n",
        "    subset = ROW_COUNT_TO_SUBSET.get(n)\n",
        "\n",
        "    if subset is None and n == 42537:\n",
        "        print(f\"  → harmless-base ({n:,} rows) — excluded (inverted preference labels)\")\n",
        "        skipped.append(fname)\n",
        "        continue\n",
        "    elif subset is None:\n",
        "        print(f\"  → UNRECOGNISED ({n:,} rows) — skipping\")\n",
        "        skipped.append(fname)\n",
        "        continue\n",
        "\n",
        "    print(f\"  → {subset} ({n:,} rows) — loading...\")\n",
        "    with gzip.open(fname, \"rt\", encoding=\"utf-8\") as f:\n",
        "        for line in f:\n",
        "            line = line.strip()\n",
        "            if not line:\n",
        "                continue\n",
        "            row = json.loads(line)\n",
        "            all_rows.append(parse_hh_row(row[\"chosen\"], row[\"rejected\"], subset))\n",
        "\n",
        "if not all_rows:\n",
        "    raise ValueError(\"No rows loaded — check files match the expected row counts above\")\n",
        "\n",
        "all_df = pd.DataFrame(all_rows)\n",
        "\n",
        "# Map to three subsets\n",
        "all_df[\"hh_subset\"] = all_df[\"source_subset\"].map(SUBSET_REMAP)\n",
        "\n",
        "print(f\"\\n=== LOADED ===\")\n",
        "print(f\"Rows per source:\")\n",
        "for src, grp in all_df.groupby(\"source_subset\"):\n",
        "    print(f\"  {src:<35}: {len(grp):,}\")\n",
        "print(f\"\\nRows per merged subset:\")\n",
        "for sub, grp in all_df.groupby(\"hh_subset\"):\n",
        "    print(f\"  {sub}: {len(grp):,}\")\n",
        "print(f\"\\nTotal rows : {len(all_df):,}\")\n",
        "print(f\"Multi-turn : {(~all_df['is_single_turn']).mean():.1%} (expected ~100%)\")\n",
        "if skipped:\n",
        "    print(f\"\\nSkipped files: {skipped}\")"
      ]
    },
