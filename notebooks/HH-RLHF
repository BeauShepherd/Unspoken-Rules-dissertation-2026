        "try:\n",
        "    embedding_model\n",
        "except NameError:\n",
        "    print(\"Reloading embedding model...\")\n",
        "    embedding_model = SentenceTransformer(\"all-MiniLM-L6-v2\")\n",
        "\n",
        "N_RUNS            = 20\n",
        "run_topics_list   = []\n",
        "n_topics_list     = []\n",
        "outlier_rate_list = []\n",
        "\n",
        "print(f\"Refitting {N_RUNS} times...\\n\")\n",
        "for run in range(N_RUNS):\n",
        "    m = BERTopic(\n",
        "        embedding_model=embedding_model,\n",
        "        min_topic_size=30,\n",
        "        nr_topics=50,\n",
        "        verbose=False,\n",
        "    )\n",
        "    t, _ = m.fit_transform(comments, embeddings=embeddings)\n",
        "    n    = len(set(t)) - (1 if -1 in t else 0)\n",
        "    o    = sum(1 for x in t if x == -1) / len(t)\n",
        "    run_topics_list.append(t)\n",
        "    n_topics_list.append(n)\n",
        "    outlier_rate_list.append(o)\n",
        "    print(f\"  Run {run+1:2d}: {n} topics, {o:.1%} outliers\")\n",
        "\n",
        "ari_scores = [\n",
        "    adjusted_rand_score(run_topics_list[i], run_topics_list[j])\n",
        "    for i in range(N_RUNS)\n",
        "    for j in range(i + 1, N_RUNS)\n",
        "]\n",
        "\n",
        "fig_stab = make_subplots(rows=1, cols=3,\n",
        "    subplot_titles=[\"Topics per run\", \"Outlier rate per run\", \"Pairwise ARI\"])\n",
        "fig_stab.add_trace(\n",
        "    go.Histogram(x=n_topics_list,     nbinsx=10, marker_color=\"steelblue\"), row=1, col=1)\n",
        "fig_stab.add_trace(\n",
        "    go.Histogram(x=outlier_rate_list, nbinsx=10, marker_color=\"coral\"),     row=1, col=2)\n",
        "fig_stab.add_trace(\n",
        "    go.Histogram(x=ari_scores,        nbinsx=20, marker_color=\"seagreen\"),  row=1, col=3)\n",
        "fig_stab.update_layout(\n",
        "    title=\"BERTopic stability — HH-RLHF human context turns\",\n",
        "    showlegend=False, height=400\n",
        ")\n",
        "fig_stab.show()\n",
        "\n",
