        "\n",
        "short_chosen_mask   = all_df[\"chosen_response\"].str.len() < MIN_CHOSEN_LEN\n",
        "short_rejected_mask = all_df[\"rejected_response\"].str.len() < MIN_REJECTED_LEN\n",
        "identical_mask      = (\n",
        "    all_df[\"chosen_response\"].str.len() - all_df[\"rejected_response\"].str.len()\n",
        ").abs() < MIN_LENGTH_DIFF\n",
        "\n",
        "noise_mask   = short_chosen_mask | short_rejected_mask | identical_mask\n",
        "all_df_clean = all_df[~noise_mask].reset_index(drop=True)\n",
        "\n",
        "print(f\"Before cleaning       : {len(all_df):,} rows\")\n",
