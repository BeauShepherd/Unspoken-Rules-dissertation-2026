        "print(f\"Near-identical pairs  : {identical_mask.sum():,}\")\n",
        "print(f\"Total removed         : {noise_mask.sum():,}\")\n",
        "print(f\"After cleaning        : {len(all_df_clean):,} rows\")\n",
        "\n",
        "comments = all_df_clean[\"human_context\"].tolist()"
      ]
